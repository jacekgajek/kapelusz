<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sync with the Kapelusz API. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- No notifications at all: Firebase Messaging, used only to sync, would ask for it. -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- Lets the website see that the app is installed (asset_statements.xml). -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />
        <!-- Compose follows these changes itself: turning the phone, dark mode, split screen or a foldable no
             longer rebuild the activity, which would close dialogs and reset forms. Language is left to Android. -->
        <activity
            android:name=".android.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Photos and PDFs shared to Kapelusz: attached to a cost, received money or an event. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <!-- Join links (/join/CODE) and event links (/e/EVENT_ID) open the app; verified via assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="kapelusz.jacekgajek.com" android:pathPrefix="/join/" />
                <data android:scheme="https" android:host="kapelusz.jacekgajek.com" android:pathPrefix="/e/" />
            </intent-filter>
        </activity>
        <!-- Play services downloads the QR scanner with the app, not on the first scan. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />
        <!-- Its invisible go-between to Play services' scanner screen comes locked to portrait, which Play flags for
             large screens (and Android 16 ignores there): unlocked, so nothing in the app restricts orientation. Lint
             can't see the class, which comes inside Play services' library. -->
        <activity
            android:name="com.google.mlkit.vision.codescanner.internal.GmsBarcodeScanningDelegateActivity"
            tools:ignore="MissingClass"
            tools:remove="android:screenOrientation" />
        <!-- Google Maps, for picking a place on a map. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${googleMapsKey}" />
        <!-- Sync messages, not notifications: "band X changed" makes the app on screen sync it. -->
        <service
            android:name="com.jacekgajek.kapelusz.app.sync.SyncMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Firebase starts only after sign-in, and only messaging: no token before, no Analytics. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="true" />

        <!-- Hands the camera app a file to write a photo for a cost attachment into (cache/photos). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
