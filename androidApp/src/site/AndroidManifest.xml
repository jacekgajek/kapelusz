<?xml version="1.0" encoding="utf-8"?>
<!-- The website's APK (ITERATION_7 §1.1): automatic updates without the Play Store (ITERATION_2 §1). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Only for "update ready to install" (no other notifications since ITERATION_6 §9); without it, the app's strip. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <receiver
            android:name="com.jacekgajek.kapelusz.app.updates.InstallResultReceiver"
            android:exported="false" />
    </application>

</manifest>
