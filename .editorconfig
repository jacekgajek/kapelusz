# Formatting is enforced by ktlint (./gradlew ktlintCheck, part of check); ./gradlew ktlintFormat fixes what it can.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 140
ktlint_code_style = intellij_idea
ij_kotlin_imports_layout = *
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Composables are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Long lines are not auto-correctable; detekt's MaxLineLength (baselined) fails new ones, old ones go as files are touched.
ktlint_standard_max-line-length = disabled
# File names follow the feature, not the single declaration inside (expect/actual files, platform files); off until the
# platform-layer reorganisation (REFACTORING.md step 4.4) settles the names.
ktlint_standard_filename = disabled

[*.{yml,yaml,xml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
